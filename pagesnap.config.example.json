{
  "schedule": "0 */6 * * *",
  "outputDir": "./snapshots",
  "reportFile": "./report.jsonl",
  "auditLog": "./audit.jsonl",
  "alertLog": "./alerts.jsonl",
  "retention": {
    "maxAgeDays": 30,
    "maxSnapshotsPerSlug": 50
  },
  "alert": {
    "threshold": 0.05,
    "notify": true
  },
  "webhook": {
    "url": "https://hooks.example.com/pagesnap",
    "secret": "mysecret"
  },
  "plugins": [
    "./plugins/my-plugin.js"
  ],
  "pages": [
    {
      "url": "https://example.com",
      "schedule": "0 * * * *",
      "viewport": { "width": 1280, "height": 800 }
    },
    {
      "url": "https://example.com/about",
      "viewport": { "width": 1280, "height": 800 }
    }
  ]
}
