{
  "snapshotDir": "snapshots",
  "schedule": "0 * * * *",
  "retention": {
    "maxAgeDays": 30,
    "maxCount": 100
  },
  "alertThreshold": 0.05,
  "webhookEnabled": true,
  "webhookUrl": "https://hooks.example.com/pagesnap",
  "webhookSecret": "change-me",
  "webhookRetries": 2,
  "pages": [
    {
      "url": "https://example.com",
      "schedule": "*/30 * * * *",
      "webhookUrl": "https://hooks.example.com/example-com"
    },
    {
      "url": "https://example.com/about",
      "webhookEnabled": false
    }
  ]
}
